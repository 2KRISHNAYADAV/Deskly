{
  "name": "deskly-academic",
  "version": "1.0.0",
  "description": "Deskly Academic Edition - Local-first digital wellbeing and human-computer interaction analysis system for Windows",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite build && electron .",
    "dev:safe": "npm run preflight && vite build && electron .",
    "dev:watch": "concurrently \"npm run watch\" \"wait-on dist/renderer/index.html && electron .\"",
    "watch": "vite build --watch --mode development",
    "build": "npm run preflight && vite build && electron-builder",
    "build:win": "npm run preflight && vite build && electron-builder --win",
    "build:quick": "vite build && electron-builder",
    "build:academic": "vite build && electron-builder --win --config.compression=normal",
    "preflight": "node src/main/utils/preflight.js",
    "validate": "node src/main/utils/validate-tracking.js",
    "validate:week": "node src/main/utils/validate-tracking.js --week",
    "health": "node src/main/utils/health-check.js",
    "inspect": "node src/main/utils/vault-inspector.js",
    "inspect:week": "node src/main/utils/vault-inspector.js --range 7",
    "check": "npm run validate && npm run validate:week",
    "check:all": "npm run preflight && npm run validate && npm run validate:week",
    "icons": "node build/generate-icons.js"
  },
  "author": "Deskly Academic Edition - Final Year Project",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.4.0",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/material-symbols-rounded": "^5.2.38",
    "electron-store": "^8.1.0",
    "framer-motion": "^12.23.26",
    "i18next": "^26.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8"
  },
  "build": {
    "appId": "edu.deskly.academic",
    "productName": "Deskly Academic Edition",
    "copyright": "Copyright © 2026 Deskly Academic Edition - Final Year Project",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,LICENSE,license,LICENCE}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples,docs}",
      "!**/node_modules/.bin"
    ],
    "extraFiles": [
      {
        "from": "build/goodbye.ps1",
        "to": "resources/goodbye.ps1"
      },
      {
        "from": "src/main/scripts/icon-extractor.ps1",
        "to": "resources/scripts/icon-extractor.ps1"
      },
      {
        "from": "assets/icons/icon-256.png",
        "to": "resources/icon.png"
      },
      {
        "from": "assets/icons/icon.ico",
        "to": "resources/icon.ico"
      },
      {
        "from": "assets/icons/tray-icon.png",
        "to": "resources/tray-icon.png"
      },
      {
        "from": "assets/icons/tray-icon@2x.png",
        "to": "resources/tray-icon@2x.png"
      }
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deskly Academic Edition",
      "uninstallDisplayName": "Deskly Academic Edition",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "artifactName": "DesklyAcademic-Setup-${version}.exe",
      "runAfterFinish": true,
      "menuCategory": "Deskly Academic Edition",
      "license": null,
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "DesklyAcademic-${version}-portable.exe"
    }
  }
}
